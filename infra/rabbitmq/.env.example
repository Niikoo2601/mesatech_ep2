# Copiar a .env en la EC2 C:  cp .env.example .env && chmod 600 .env
# Valores FICTICIOS. El archivo .env real NO se sube al repositorio.

# Administrador del broker (interfaz web 15672). No es usado por las aplicaciones.
RABBITMQ_ADMIN_USER=mesatech_admin
RABBITMQ_ADMIN_PASSWORD=cambiar_esta_clave_admin

# Recursos del proyecto (usados por configurar-recursos.sh)
RABBITMQ_VHOST=mesatech
RABBITMQ_EXCHANGE=catalogo.exchange
RABBITMQ_QUEUE=solicitudes.catalogo.queue
RABBITMQ_ROUTING_KEY=categoria.creada

# Usuario del PUBLICADOR (microservicio Catálogo, EC2 A)
RABBITMQ_PUBLICADOR_USER=catalogo_publicador
RABBITMQ_PUBLICADOR_PASSWORD=cambiar_esta_clave_publicador

# Usuario del CONSUMIDOR (microservicio Solicitudes, EC2 B)
RABBITMQ_CONSUMIDOR_USER=solicitudes_consumidor
RABBITMQ_CONSUMIDOR_PASSWORD=cambiar_esta_clave_consumidor
