# Copiar a /etc/mesatech/catalogo.env en la EC2 A (permisos 600). Valores FICTICIOS.
SERVER_PORT=8082
DB_URL=jdbc:mysql://mesatech-catalogo-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:3306/mesatech_catalogo?serverTimezone=UTC
DB_USERNAME=catalogo_app
